{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RedSalamanders CI project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "engine", "kind"],
  "if": { "properties": { "kind": { "const": "documentation" } } },
  "then": {
    "properties": { "repository": { "const": "RedSalamanders/RedHome" } },
    "propertyNames": { "enum": ["schemaVersion", "repository", "engine", "kind"] }
  },
  "else": {
    "required": ["policyVersion", "adapter", "include", "exclude", "formatRoots", "versionBase", "winget"],
    "properties": { "repository": { "pattern": "^RedSalamanders/(RedSalamander|DxUi|RedXe|RedPrism|RedTilde|RedMonitor)$" } }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyVersion": { "const": "1" },
    "repository": { "type": "string" },
    "engine": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "ref"],
      "properties": { "repository": { "const": "RedSalamanders/.github" }, "ref": { "type": "string", "pattern": "^[0-9a-f]{40}$" } }
    },
    "kind": { "enum": ["application", "sdk", "documentation"] },
    "adapter": { "const": "Tools/Invoke-ProjectCi.ps1" },
    "include": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "formatRoots": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+$" }, "uniqueItems": true },
    "formatExclude": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "versionBase": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "winget": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["identifier", "executable", "alias"], "properties": {
          "identifier": { "type": "string", "pattern": "^[A-Za-z0-9]+\\.[A-Za-z0-9.]+$" },
          "executable": { "type": "string", "pattern": "^[A-Za-z0-9]+\\.exe$" },
          "alias": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
          "minimumOSVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "additionalCommands": {
            "type": "array", "uniqueItems": true,
            "items": {"type":"object","additionalProperties":false,"required":["executable","alias"],"properties":{
              "executable":{"type":"string","pattern":"^[A-Za-z0-9]+\\.exe$"},
              "alias":{"type":"string","pattern":"^[A-Za-z0-9-]+$"}
            }}
          },
          "smokeTests": {
            "type":"array","maxItems":8,"items":{"type":"object","additionalProperties":false,"required":["command","arguments","timeoutSeconds"],"properties":{
              "command":{"type":"string","pattern":"^[A-Za-z0-9-]+$"},
              "arguments":{"type":"array","maxItems":32,"items":{"type":"string","maxLength":512}},
              "timeoutSeconds":{"type":"integer","minimum":1,"maximum":600}
            }}
          },
          "license": { "type": "string", "pattern": "^[A-Za-z0-9 .()-]*$" },
          "releaseNotes": { "type": "boolean" },
          "localeMetadata": {
            "type": "object", "additionalProperties": false, "properties": {
              "PublisherUrl": { "type": "string", "minLength": 1 },
              "PublisherSupportUrl": { "type": "string", "minLength": 1 },
              "Author": { "type": "string", "minLength": 1 },
              "LicenseUrl": { "type": "string", "minLength": 1 },
              "Copyright": { "type": "string", "minLength": 1 },
              "ShortDescription": { "type": "string", "minLength": 1 },
              "Description": { "type": "string", "minLength": 1 },
              "Moniker": { "type": "string", "minLength": 1 },
              "Tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "InstallationNotes": { "type": "string", "minLength": 1 },
              "Documentations": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["DocumentLabel", "DocumentUrl"],
                  "properties": {
                    "DocumentLabel": { "type": "string", "minLength": 1 },
                    "DocumentUrl": { "type": "string", "minLength": 1 }
                  }
                }
              }
            }
          }
        } }
      ]
    }
  }
}
