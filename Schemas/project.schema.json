{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RedSalamanders CI project adapter",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyVersion", "repository", "engine", "kind", "adapter", "include", "exclude", "formatRoots", "versionBase", "winget"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyVersion": { "const": "1" },
    "repository": { "type": "string", "pattern": "^RedSalamanders/(RedSalamander|DxUi|RedXe|RedPrism|RedTilde|RedMonitor)$" },
    "engine": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "ref"],
      "properties": { "repository": { "const": "RedSalamanders/.github" }, "ref": { "type": "string", "pattern": "^[0-9a-f]{40}$" } }
    },
    "kind": { "enum": ["application", "sdk"] },
    "adapter": { "const": "Tools/Invoke-ProjectCi.ps1" },
    "include": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "formatRoots": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z0-9_./-]+$" }, "uniqueItems": true },
    "formatExclude": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "versionBase": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "winget": {
      "oneOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["identifier", "executable", "alias"], "properties": {
          "identifier": { "type": "string", "pattern": "^[A-Za-z0-9]+\\.[A-Za-z0-9.]+$" },
          "executable": { "type": "string", "pattern": "^[A-Za-z0-9]+\\.exe$" },
          "alias": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
          "additionalCommands": {
            "type": "array", "uniqueItems": true,
            "items": {"type":"object","additionalProperties":false,"required":["executable","alias"],"properties":{
              "executable":{"type":"string","pattern":"^[A-Za-z0-9]+\\.exe$"},
              "alias":{"type":"string","pattern":"^[A-Za-z0-9-]+$"}
            }}
          },
          "license": { "type": "string", "pattern": "^[A-Za-z0-9 .()-]*$" }
        } }
      ]
    }
  }
}
