{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "role",
    "repository",
    "baseCommit",
    "groupCommit",
    "groupRef",
    "groupTree",
    "controllerEngineRef",
    "input",
    "baseNativeDigest",
    "nativeRequired",
    "identity"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "role": {
      "const": "MergeGroupInputs"
    },
    "repository": {
      "type": "string",
      "pattern": "^RedSalamanders/(RedSalamander|DxUi|RedXe|RedPrism|RedTilde|RedMonitor)$"
    },
    "baseCommit": {
      "$ref": "#/$defs/commit"
    },
    "controllerEngineRef": {
      "$ref": "#/$defs/commit"
    },
    "baseNativeDigest": {
      "$ref": "#/$defs/hash"
    },
    "nativeRequired": {
      "type": "boolean"
    },
    "identity": {
      "$ref": "#/$defs/hash"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "repository",
        "commit",
        "engine",
        "policyVersion",
        "nativeDigest",
        "buildNumber",
        "version",
        "inputCount"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "repository": {
          "type": "string"
        },
        "commit": {
          "$ref": "#/$defs/commit"
        },
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "ref"
          ],
          "properties": {
            "repository": {
              "const": "RedSalamanders/.github"
            },
            "ref": {
              "$ref": "#/$defs/commit"
            }
          }
        },
        "policyVersion": {
          "const": "1"
        },
        "nativeDigest": {
          "$ref": "#/$defs/hash"
        },
        "buildNumber": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "inputCount": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "groupCommit": {
      "$ref": "#/$defs/commit"
    },
    "groupTree": {
      "$ref": "#/$defs/commit"
    },
    "groupRef": {
      "type": "string",
      "pattern": "^refs/heads/gh-readonly-queue/main/[A-Za-z0-9_-][A-Za-z0-9_/-]*$"
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
