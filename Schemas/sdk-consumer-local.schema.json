{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "role", "sourceCommit", "apiRevision", "platform", "sourceRoot", "toolingRoot", "storageEngineRoot", "storeRoot", "manifestSha256"],
  "properties": {
    "schemaVersion": {"const": 1},
    "role": {"const": "LocalPinnedDependencyInput"},
    "sourceCommit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "apiRevision": {"type": "integer", "minimum": 1, "maximum": 65535},
    "platform": {"enum": ["x64", "ARM64"]},
    "sourceRoot": {"type": "string", "minLength": 1},
    "toolingRoot": {"type": "string", "minLength": 1},
    "storageEngineRoot": {"type": "string", "minLength": 1},
    "storeRoot": {"type": "string", "minLength": 1},
    "manifestSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
