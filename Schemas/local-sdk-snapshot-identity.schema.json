{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "role", "producerRoot", "inputs", "bindings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "role": { "const": "LocalUnpinnedSdkSnapshot" },
    "producerRoot": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "inputs": { "type": "object" },
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["headers", "libraries", "symbols", "integration", "licenses", "buildProvenance"],
      "properties": {
        "headers": { "$ref": "#/$defs/paths" },
        "libraries": { "$ref": "#/$defs/paths" },
        "symbols": { "$ref": "#/$defs/paths" },
        "integration": { "$ref": "#/$defs/paths" },
        "licenses": { "$ref": "#/$defs/paths" },
        "buildProvenance": { "$ref": "#/$defs/paths" }
      }
    }
  },
  "$defs": {
    "paths": { "type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 } }
  }
}
