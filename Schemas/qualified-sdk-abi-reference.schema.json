{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "role", "sourceCommit", "sourceBytes", "publicHeadersGitTree", "apiRevision", "platform", "inputKey", "manifestSha256", "producerTooling", "producerStorageEngine", "sdkReceiptSha256", "toolchainReference"],
  "properties": {
    "schemaVersion": {"const": 2}, "role": {"const": "QualifiedSdkAbiReference"},
    "sourceCommit": {"$ref": "#/$defs/commit"}, "sourceBytes": {"$ref": "#/$defs/hash"},
    "publicHeadersGitTree": {"$ref": "#/$defs/commit"},
    "apiRevision": {"type": "integer", "minimum": 1, "maximum": 65535},
    "platform": {"enum": ["x64", "ARM64"]},
    "inputKey": {"$ref": "#/$defs/hash"}, "manifestSha256": {"$ref": "#/$defs/hash"},
    "producerTooling": {"$ref": "#/$defs/code"}, "producerStorageEngine": {"$ref": "#/$defs/code"},
    "sdkReceiptSha256": {"$ref": "#/$defs/hash"},
    "toolchainReference": {"type": "object"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "commit": {"type": "string", "pattern": "^(?!0{40}$)[a-f0-9]{40}$"},
    "code": {"type": "object", "additionalProperties": false, "required": ["commit", "contentIdentity"],
      "properties": {"commit": {"$ref": "#/$defs/commit"}, "contentIdentity": {"$ref": "#/$defs/hash"}}}
  }
}
