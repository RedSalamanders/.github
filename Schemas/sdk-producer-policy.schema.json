{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,
  "required":["schemaVersion","repository","toolingRef","toolingContentIdentity","storageEngineRef","sources"],
  "properties":{
    "schemaVersion":{"const":1},"repository":{"const":"RedSalamanders/DxUi"},
    "toolingRef":{"$ref":"#/$defs/commit"},"toolingContentIdentity":{"$ref":"#/$defs/hash"},"storageEngineRef":{"$ref":"#/$defs/commit"},
    "sources":{"type":"array","minItems":1,"maxItems":16,"items":{"type":"object","additionalProperties":false,
      "required":["commit","apiRevision","contentIdentity"],"properties":{"commit":{"$ref":"#/$defs/commit"},"contentIdentity":{"$ref":"#/$defs/hash"},"apiRevision":{"type":"integer","minimum":1,"maximum":65535}}}}
  },"$defs":{"commit":{"type":"string","pattern":"^(?!0{40}$)[a-f0-9]{40}$"},"hash":{"type":"string","pattern":"^[a-f0-9]{64}$"}}
}
