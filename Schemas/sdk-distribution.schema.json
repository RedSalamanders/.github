{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object","additionalProperties":false,"required":["schemaVersion","entries"],
  "properties":{"schemaVersion":{"const":1},"entries":{"type":"array","maxItems":20,"items":{
    "type":"object","additionalProperties":false,"required":["sourceCommit","apiRevision","runId","attempt"],
    "properties":{"sourceCommit":{"type":"string","pattern":"^[a-f0-9]{40}$"},"apiRevision":{"type":"integer","minimum":1,"maximum":65535},
      "contract":{"enum":["LegacyV1","QualifiedAbiV2"]},
      "runId":{"type":"string","pattern":"^[1-9][0-9]{0,19}$"},"attempt":{"type":"integer","minimum":1,"maximum":100000}}
  }}}}
